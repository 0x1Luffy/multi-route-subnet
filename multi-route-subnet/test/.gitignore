# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Exclude all .tfvars files (may contain secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Terraform plan files
*.tfplan
plan.out

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file only if you don't want provider version locking
# Usually recommended to KEEP this file in git
# .terraform.lock.hcl

# Ignore IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment files
.env
.env.*

# Optional: Ignore Terragrunt cache
.terragrunt-cache/

# Optional: Ignore Atlantis/Terramate generated files
*.tfvars.backup
